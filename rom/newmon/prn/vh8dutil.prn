 00B7 32A220    	sta	ddvctl
 00BA 32A320    	sta	ddlymo
 00BD FB        	ei
 00BE CDE804    	call	m$sdp	; hacked sdp - restart motors, too
 00C1 CD7620    	call	dsdt	; seek to track (dis intrs)
 00C4 AF        	xra	a
 00C5 D37E      	out	7eh
 00C7 3C        	inr	a
 00C8 325320    	sta	dwhda
 00CB 3AA220    	lda	ddvctl
 00CE 3C        	inr	a
 00CF D37F      	out	7fh
                trk1:
 00D1 CD8820    	call	dsts	; skip this sector
 00D4 3AA420    	lda	ddlyhs
 00D7 A7        	ana	a
 00D8 C2D100    	jnz	trk1	; wait delay
 00DB 2AA720    	lhld	dvolpt
 00DE 46        	mov	b,m	; vol# (0/curvol)
 00DF 2AB606    	lhld	secpntr	; HL = ptr into sec interleave table
                trk2:
 00E2 0E0A      	mvi	c,10
 00E4 CDED1E    	call	wsp1	; writes 0's
 00E7 78        	mov	a,b	; vol#
 00E8 CD9720    	call	dwnb
 00EB 3AA020    	lda	dtt	; track
 00EE CD9720    	call	dwnb
 00F1 7E        	mov	a,m	; sec#
 00F2 CD9720    	call	dwnb
