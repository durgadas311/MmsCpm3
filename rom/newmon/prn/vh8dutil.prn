 00F6 7A        	mov	a,d	; ?chksum?
 00F7 CD9720    	call	dwnb
 00FA 0E10      	mvi	c,16
 00FC CDED1E    	call	wsp1
                trk3:
 00FF CD9720    	call	dwnb
 0102 0D        	dcr	c	; 256 0's
 0103 C2FF00    	jnz	trk3
                trk4:
 0106 AF        	xra	a
 0107 CD9720    	call	dwnb	; end pad
 010A DB7F      	in	7fh
