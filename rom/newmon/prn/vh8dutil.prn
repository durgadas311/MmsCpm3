 0112 C2E200    	jnz	trk2	; until end of track
 0115 3AA220    	lda	ddvctl
 0118 D37F      	out	7fh
 011A FB        	ei
 011B CD5E20    	call	dxok
 011E 3E14      	mvi	a,20
 0120 325320    	sta	dwhda
 0123 210820    	lxi	h,mflag	; turn off counter ?
 0126 7E        	mov	a,m
 0127 E6FE      	ani	11111110b
 0129 77        	mov	m,a
 012A C9        	ret
                
                ; Read file from VDIP1 into 'buffer'.
                ; Reads 1 H17 track - 10x256 sectors.
                ; File was already opened.
                ; Read 128 bytes at a time, as per vdrd routine.
 012B 21BF06    vrtrk:	lxi	h,buffer
 012E 0614      	mvi	b,20	; 20 records == 10 sectors
 0130 C5        vrt0:	push	b
 0131 CD0000    	call	vdrd
 0134 C1        	pop	b
 0135 D8        	rc	; error
                	djnz	vrt0
 0136+10F8      	DB	10H,VRT0-$-1
 0138 C9        	ret
                
                ; Write to file on VDIP1 from 'buffer'.
                ; Writes 1 H17 track - 10x256 sectors.
                ; File was already opened (for write).
                ; Write 512 bytes at a time.
 0139 11BF06    vwtrk:	lxi	d,buffer
