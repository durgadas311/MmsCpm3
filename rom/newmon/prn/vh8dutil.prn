                ;
 01F8 CD3601    	call	vwtrk
 01FB D8        	rc
 01FC 3AB206    	lda	opsts
 01FF B7        	ora	a
 0200 3E53      	mvi	a,'S'
 0202 CA0702    	jz	rdimg2
 0205 3E65      	mvi	a,'e'
 0207 CDB804    rdimg2:	call	chrout
 020A CDCE04    	call	ckctlc
 020D DA5200    	jc	abort
                
                	; next sector...
 0210 2AB606    	lhld	secnum
 0213 110A00    	lxi	d,10	; sec/trk
 0216 19        	dad	d
 0217 22B606    	shld	secnum
 021A 1170FE    	lxi	d,-400	; 400 sectors max
 021D 19        	dad	d
 021E 7C        	mov	a,h
 021F B5        	ora	l	; last track? ZR=yes
 0220 3AA606    	lda	curvol
 0223 C2E801    	jnz	rdimg1
 0226 C34D04    	jmp	crlf
                
