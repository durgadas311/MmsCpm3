                ; Standalone utility to dump core for CP/M 3 (H8x512K) on VDIP1
                ; linked with vdip1.rel
 0011 =         VERN	equ	011h
                
                	extrn	strcpy,strcmp,sync,runout
                	extrn	vdcmd,vdend,vdrd,vdmsg,vdout,vdprmp
                	public	vdbuf
                
 000D =         CR	equ	13
 000A =         LF	equ	10
 0007 =         BEL	equ	7
 0003 =         CTLC	equ	3
 0008 =         BS	equ	8
                
                	maclib	z180
                	maclib	core
                	aseg
                	maclib	ram
                
                ;...
                
                ; Commands:
                ;	D n	set Drive number
                ;	V n	set Volume ID
                ;	I n	Set sector Interleave
                ;	R file	Restore image from file (Recreate floppy)
                ;	S file	Save image to file (Save floppy)
                
 0A00 =         zbuf	equ	0a00h	; buffer size 1 track
 0100 =         zstk	equ	100h	; stack size
                
                ; disk addresses for H17Floppy ROM and RAM
 2061 =         dabort	equ	2061h	; jmp L1bf6
 2085 =         dsdp	equ	2085h
 2076 =         dsdt	equ	2076h
 2088 =         dsts	equ	2088h
 208B =         dstz	equ	208bh
 1C19 =         clock	equ	1c19h	; 034.031 CLOCK
 1DD1 =         rlps	equ	1dd1h	; 035.321 R.LPS - locate sector
 1E32 =         rsdp	equ	1e32h	; 036.062 R.SDP
 1EED =         wsp1	equ	1eedh	; 036.355 W.SP1
 2097 =         dwnb	equ	2097h
 205E =         dxok	equ	205eh
 206D =         dwrite	equ	206dh
 2067 =         dread	equ	2067h
 201F =         uivec	equ	201fh
 2008 =         mflag	equ	2008h
 20A0 =         dtt	equ	20a0h
 20A4 =         ddlyhs	equ	20a4h
 20A2 =         ddvctl	equ	20a2h
 20A3 =         ddlymo	equ	20a3h
 20A9 =         ddrvtb	equ	20a9h
 20A7 =         dvolpt	equ	20a7h
 2053 =         dwhda	equ	2053h
 2073 =         ddts	equ	2073h
 208E =         dudly	equ	208eh
 2091 =         dwsc	equ	2091h
 2082 =         drdb	equ	2082h
 204E =         dlpsa	equ	204eh
                
                	cseg
 0000 F3        	di
 0001 31A913    	lxi	sp,spint
 0004 3AFE0F    	lda	prodid	; LSB of product ID
 0007 E601      	ani	prnofp	; No FP?
 0009 32A000    	sta	nofp
                
                	; These hacks do not need to be un-done because the
                	; ROM always re-initializes before any boot.
 000C 21D204    	lxi	h,m$sdp	; hack R.SDP to work for 3 drives
 000F 228620    	shld	D$CONST+62
 0012 21E504    	lxi	h,m$lps	; hack R.LPS to ignore volume ID (format still sets it)
 0015 228020    	shld	D$CONST+56
                
 0018 3EC3      	mvi	a,0c3h	; jmp
 001A 321F20    	sta	uivec
 001D 21191C    	lxi	h,clock
 0020 222020    	shld	uivec+1
 0023 31A913    	lxi	sp,spint
 0026 210820    	lxi	h,mflag	; turn on counter
 0029 7E        	mov	a,m
 002A F601      	ori	00000001b
 002C 77        	mov	m,a
 002D CD6000    	call	ena2ms
 0030 FB        	ei
 0031 114505    	lxi	d,signon
 0034 CDC904    	call	print
 0037 115205    	lxi	d,phelp
 003A CDC904    	call	print
                	; (2mS intr must be ON) track 0
 003D CD7603    	call	shwprm
 0040 3A9206    	lda	curdrv
 0043 323121    	sta	AIO$UNI
                main1:
                	; Prompt for command and params,
                	; perform command,
                	; close file...
 0046 CD2202    	call	comnd
                	jrnc	main1
 0049+30FB      	DB	30H,MAIN1-$-1
                exit:
 004B CD8400    	call	dis2ms
 004E 2A1E00    	lhld	retmon
 0051 E9        	pchl
                
 0052 118406    abort:	lxi	d,abrted
 0055 CDC904    	call	print
 0058 212103    	lxi	h,clf
 005B CD0000    	call	vdcmd
                	jr	main1
 005E+18E6      	DB	18H,MAIN1-$-1
                
                ; Turn on 2mS clock intrs, interrupts already disabled
 0060 3AA000    ena2ms:	lda	nofp
 0063 B7        	ora	a
                	jrnz	nfp2ms	; H89 and/or extended H8-Z80 boards
 0064+200D      	DB	20H,NFP2MS-$-1
 0066 210920    	lxi	h,ctl$F0
 0069 7E        	mov	a,m
 006A 32A100    	sta	sav$F0
 006D F640      	ori	01000000b	; 2mS ON
 006F 77        	mov	m,a
 0070 D3F0      	out	0f0h
 0072 C9        	ret
 0073 213620    nfp2ms:	lxi	h,ctl$F2
 0076 7E        	mov	a,m
 0077 32A200    	sta	sav$F2
 007A F602      	ori	00000010b	; 2mS ON
 007C 77        	mov	m,a
 007D D3F2      	out	0f2h
 007F E602      	ani	00000010b	; unlock enable
 0081 D3F3      	out	0f3h		; special Z80 board extension
 0083 C9        	ret
                
 0084 3AA000    dis2ms:	lda	nofp
 0087 B7        	ora	a
                	jrnz	nfp0ms
 0088+2009      	DB	20H,NFP0MS-$-1
 008A 3AA100    	lda	sav$F0
 008D 320920    	sta	ctl$F0
 0090 D3F0      	out	0f0h
 0092 C9        	ret
 0093 3AA200    nfp0ms:	lda	sav$F2
 0096 323620    	sta	ctl$F2
 0099 D3F2      	out	0f2h
 009B E602      	ani	00000010b	; unlock enable
 009D D3F3      	out	0f3h		; special Z80 board extension
 009F C9        	ret
                
 00A0 00        nofp:	db	0
 00A1 00        sav$F0:	db	0
 00A2 00        sav$F2:	db	0
                
                ; format a single track
                ; B = track, C = vol# (not used)
                ftrk:
 00A3 F3        	di
 00A4 210820    	lxi	h,mflag	; turn on counter
 00A7 7E        	mov	a,m
 00A8 F601      	ori	00000001b
 00AA 77        	mov	m,a
 00AB 78        	mov	a,b
 00AC 32A020    	sta	dtt
 00AF 3E02      	mvi	a,2
 00B1 32A420    	sta	ddlyhs
 00B4 AF        	xra	a
 00B5 D37F      	out	7fh
 00B7 32A220    	sta	ddvctl
 00BA 32A320    	sta	ddlymo
 00BD FB        	ei
 00BE CD7620    	call	dsdt	; seek to track (dis intrs)
 00C1 AF        	xra	a
 00C2 D37E      	out	7eh
 00C4 3C        	inr	a
 00C5 325320    	sta	dwhda
 00C8 3AA220    	lda	ddvctl
 00CB 3C        	inr	a
 00CC D37F      	out	7fh
                trk1:
 00CE CD8820    	call	dsts	; skip this sector
 00D1 3AA420    	lda	ddlyhs
 00D4 A7        	ana	a
 00D5 C2CE00    	jnz	trk1	; wait delay
 00D8 2AA720    	lhld	dvolpt
 00DB 46        	mov	b,m	; vol# (0/curvol)
 00DC 2AA006    	lhld	secpntr	; HL = ptr into sec interleave table
                trk2:
 00DF 0E0A      	mvi	c,10
 00E1 CDED1E    	call	wsp1	; writes 0's
 00E4 78        	mov	a,b	; vol#
 00E5 CD9720    	call	dwnb
 00E8 3AA020    	lda	dtt	; track
 00EB CD9720    	call	dwnb
 00EE 7E        	mov	a,m	; sec#
 00EF CD9720    	call	dwnb
 00F2 23        	inx	h	; incr sec pntr
 00F3 7A        	mov	a,d	; ?chksum?
 00F4 CD9720    	call	dwnb
 00F7 0E10      	mvi	c,16
 00F9 CDED1E    	call	wsp1
                trk3:
 00FC CD9720    	call	dwnb
 00FF 0D        	dcr	c	; 256 0's
 0100 C2FC00    	jnz	trk3
                trk4:
 0103 AF        	xra	a
 0104 CD9720    	call	dwnb	; end pad
 0107 DB7F      	in	7fh
 0109 1F        	rar
 010A D20301    	jnc	trk4	; until sec end
 010D 7E        	mov	a,m
 010E B7        	ora	a	; 0 marks end of sectable
 010F C2DF00    	jnz	trk2	; until end of track
 0112 3AA220    	lda	ddvctl
 0115 D37F      	out	7fh
 0117 FB        	ei
 0118 CD5E20    	call	dxok
 011B 3E14      	mvi	a,20
 011D 325320    	sta	dwhda
 0120 210820    	lxi	h,mflag	; turn off counter ?
 0123 7E        	mov	a,m
 0124 E6FE      	ani	11111110b
 0126 77        	mov	m,a
 0127 C9        	ret
                
                ; Read file from VDIP1 into 'buffer'.
                ; Reads 1 H17 track - 10x256 sectors.
                ; File was already opened.
                ; Read 128 bytes at a time, as per vdrd routine.
 0128 21A906    vrtrk:	lxi	h,buffer
 012B 0614      	mvi	b,20	; 20 records == 10 sectors
 012D C5        vrt0:	push	b
 012E CD0000    	call	vdrd
 0131 C1        	pop	b
 0132 D8        	rc	; error
                	djnz	vrt0
 0133+10F8      	DB	10H,VRT0-$-1
 0135 C9        	ret
                
                ; Write to file on VDIP1 from 'buffer'.
                ; Writes 1 H17 track - 10x256 sectors.
                ; File was already opened (for write).
                ; Write 512 bytes at a time.
 0136 11A906    vwtrk:	lxi	d,buffer
 0139 0605      	mvi	b,5	; 5x512 == 10x256
 013B C5        vwt0:	push	b
 013C CD4401    	call	vdwr
 013F C1        	pop	b
 0140 D8        	rc
                	djnz	vwt0
 0141+10F8      	DB	10H,VWT0-$-1
 0143 C9        	ret
                
                ; This probably should be in vdip1.asm...
                ; DE=data buffer (dma adr)
                ; Returns DE=next
 0144 215D01    vdwr:	lxi	h,wrf
 0147 CD0000    	call	vdmsg
 014A 010002    	lxi	b,512
 014D 1A        vdwr0:	ldax	d
 014E CD0000    	call	vdout
 0151 13        	inx	d
 0152 0B        	dcx	b
 0153 78        	mov	a,b
 0154 B1        	ora	c
                	jrnz	vdwr0
 0155+20F6      	DB	20H,VDWR0-$-1
 0157 D5        	push	d
 0158 CD0000    	call	vdend
 015B D1        	pop	d
 015C C9        	ret	; CY=error
                
 015D 7772662000wrf:	db	'wrf ',0,0,2,0,CR,0	; 512 byte writes
                
                setup:	; similar to R.MOUNT
 0167 CDD204    	call	m$sdp	; select unit number from AIO$UNI
 016A CD8B20    	call	dstz	; home - seek track zero
                	; dvolpt is not set - do not change
 016D C9        	ret
                
                ; Copy tracks from image file onto H17
                wrimg:
 016E CD6701    	call	setup	; select driver, etc
 0171 AF        	xra	a
 0172 32A306    	sta	secnum
 0175 32A406    	sta	secnum+1
 0178 32A206    	sta	curtrk
                wrimg1:
 017B 2AA720    	lhld	dvolpt
 017E 77        	mov	m,a	; volid starts at 0 for track 0
                ;
 017F CD2801    	call	vrtrk	; read track from image
 0182 D8        	rc
                ;
 0183 3AA206    	lda	curtrk
 0186 47        	mov	b,a
 0187 B7        	ora	a
 0188 CA8E01    	jz	wrimg3	; c is zero from above
 018B 3A9306    	lda	curvol	;  on first track
                wrimg3:
 018E 4F        	mov	c,a	;  use vol# on the rest
 018F CDA300    	call	ftrk	; format this track (B=track, C=volume
 0192 3AA206    	lda	curtrk
 0195 3C        	inr	a
 0196 32A206    	sta	curtrk	; only used to detect track 0
                ;
 0199 01000A    	lxi	b,zbuf
 019C 11A906    	lxi	d,buffer
 019F 2AA306    	lhld	secnum
 01A2 CDC901    	call	wrbuf
                ;
 01A5 3E52      	mvi	a,'R'
 01A7 CDA504    	call	chrout
 01AA CDBB04    	call	ckctlc
 01AD DA5200    	jc	abort
                
 01B0 2AA306    	lhld	secnum
 01B3 110A00    	lxi	d,10	; sec/trk
 01B6 19        	dad	d
 01B7 22A306    	shld	secnum
 01BA 1170FE    	lxi	d,-400	; 400 sectors max
 01BD 19        	dad	d
 01BE 7C        	mov	a,h
 01BF B5        	ora	l	; last track? ZR=yes
 01C0 3A9306    	lda	curvol
 01C3 C27B01    	jnz	wrimg1
 01C6 C33A04    	jmp	crlf
                
                ; Write sector(s) to H17
                ; BC = buffer size
                ; DE = buffer addr
                ; HL = first sec#
                wrbuf:
 01C9 3E02      	mvi	a,2
 01CB 32A420    	sta	ddlyhs
 01CE CD6D20    	call	dwrite
 01D1 C9        	ret
                
                ; Copy all tracks from H17 to image file
                rdimg:
 01D2 CD6701    	call	setup	; select driver, etc
 01D5 AF        	xra	a
 01D6 32A306    	sta	secnum
 01D9 32A406    	sta	secnum+1
                rdimg1:
 01DC 2AA720    	lhld	dvolpt
 01DF 77        	mov	m,a	; volid starts at 0 for track 0
                ;
 01E0 01000A    	lxi	b,zbuf
 01E3 11A906    	lxi	d,buffer
 01E6 2AA306    	lhld	secnum
 01E9 CD1402    	call	rdbuf	; read track off diskette
                ;
 01EC CD3601    	call	vwtrk
 01EF D8        	rc
 01F0 3E53      	mvi	a,'S'
 01F2 CDA504    	call	chrout
 01F5 CDBB04    	call	ckctlc
 01F8 DA5200    	jc	abort
                
                	; next sector...
 01FB 2AA306    	lhld	secnum
 01FE 110A00    	lxi	d,10	; sec/trk
 0201 19        	dad	d
 0202 22A306    	shld	secnum
 0205 1170FE    	lxi	d,-400	; 400 sectors max
 0208 19        	dad	d
 0209 7C        	mov	a,h
 020A B5        	ora	l	; last track? ZR=yes
 020B 3A9306    	lda	curvol
 020E C2DC01    	jnz	rdimg1
 0211 C33A04    	jmp	crlf
                
                ; Read sector(s) from H17
                ; BC = buffer size
                ; DE = buffer addr
                ; HL = first sec#
                rdbuf:
 0214 3E02      	mvi	a,2
 0216 32A420    	sta	ddlyhs
 0219 CD6720    	call	dread	; if carry, read error
 021C 3F        	cmc		; if carry, no error
 021D 9F        	sbb	a	; -1 if good read, else 0
 021E 329F06    	sta	goodrd
 0221 C9        	ret
                
